# Copy to backend/.env for development. Never commit the real file.

# Supabase project (Settings -> API). The anon key is public by design.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Encrypts transcript chunks before they are stored/backed up.
# Changing it makes previously stored chunks unreadable. Shared by all users of an install.
BACKEND_ENCRYPTION_KEY=change-me

# Local services
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Keep 127.0.0.1 so the API is not reachable from other devices on the network.
HOST=127.0.0.1
PORT=8000

# Ollama model used for answers
LLM_MODEL=mistral

# Maximum size of uploaded / downloaded audio files
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Desktop packaging: `npm run build:desktop` copies backend/desktop.env (NOT .env)
# into the app. Everything in desktop.env is readable by anyone who installs the app,
# so it must never contain a Supabase service-role key or JWT secret.
