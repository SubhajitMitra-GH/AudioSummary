# Copy to frontend/.env.local. NEXT_PUBLIC_* values are compiled into the app and are public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Encrypts session titles and chat messages. Shared by all users; changing it makes
# existing titles and messages unreadable.
NEXT_PUBLIC_ALE_KEY=change-me

# Local backend address (default shown)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
