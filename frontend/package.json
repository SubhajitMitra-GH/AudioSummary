{
  "name": "frontend",
  "version": "1.1.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:desktop": "next build && electron-builder --mac",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "crypto-js": "^4.2.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.tellme.app",
    "productName": "Tell Me",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend-service",
        "to": "backend-service",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/desktop.env",
        "to": "backend-service/.env"
      },
      {
        "from": "resources/redis",
        "to": "redis",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Tell-Me-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tell Me records audio so it can be transcribed and questioned on your Mac."
      }
    },
    "protocols": [
      {
        "name": "Tell Me reset link",
        "schemes": [
          "tellme"
        ]
      }
    ]
  }
}
